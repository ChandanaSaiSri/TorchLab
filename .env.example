# Copy to .env (used by docker compose). Generate a long random value for production.
JWT_SECRET=change-me-in-production
# Google sign-in (optional). See README, 'Google sign-in'.
GOOGLE_CLIENT_ID=
# Admin accounts (comma separated emails; promoted at every API start).
ADMIN_EMAILS=
# Email for verification and password reset. Leave SMTP_URL empty to print the emails in the API log instead.
# Example: smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=TorchLab <no-reply@example.com>
# Public address of the website, used in email links.
APP_URL=http://localhost:5173
# AI study assistant (optional). Without a key the AI buttons are hidden.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_DAILY_LIMIT=40
